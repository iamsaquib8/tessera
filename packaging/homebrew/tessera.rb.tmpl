class Tessera < Formula
  desc "Deterministic edit safety for AI coding agents"
  homepage "https://github.com/iamsaquib8/tessera"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/iamsaquib8/tessera/releases/download/v{{VERSION}}/tessera-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA_AARCH64_APPLE_DARWIN}}"
    end
    on_intel do
      url "https://github.com/iamsaquib8/tessera/releases/download/v{{VERSION}}/tessera-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA_X86_64_APPLE_DARWIN}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/iamsaquib8/tessera/releases/download/v{{VERSION}}/tessera-aarch64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA_AARCH64_UNKNOWN_LINUX_MUSL}}"
    end
    on_intel do
      url "https://github.com/iamsaquib8/tessera/releases/download/v{{VERSION}}/tessera-x86_64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA_X86_64_UNKNOWN_LINUX_MUSL}}"
    end
  end

  def install
    bin.install "tessera"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tessera --version")
  end
end
