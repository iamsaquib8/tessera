    "tessera": "bin/tessera.js"
  },
  "files": [
    "bin/tessera.js",
    "lib/resolve.js"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "code-graph",
    "tree-sitter",
    "refactoring",
    "static-analysis"
  ],
  "homepage": "https://github.com/iamsaquib8/tessera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsaquib8/tessera.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "tessera-codegraph-darwin-arm64": "0.10.0",
    "tessera-codegraph-darwin-x64": "0.10.0",
    "tessera-codegraph-linux-x64-musl": "0.10.0",
    "tessera-codegraph-linux-arm64-musl": "0.10.0",
    "tessera-codegraph-win32-x64": "0.10.0"
  }
}
